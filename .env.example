# Bu dosyayı ".env" olarak kopyalayın ve gerçek değerlerinizi girin.
# .env dosyasını ASLA GitHub'a yüklemeyin!

FLASK_ORTAMI=gelistirme
SECRET_KEY=rastgele-uzun-bir-sifre-yazin

AI_PROVIDER=groq
GROQ_API_KEY=gsk_buraya-anahtarinizi-yapistirin
GEMINI_API_KEY=
OPENAI_API_KEY=

